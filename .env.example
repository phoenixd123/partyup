# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the PUBLIC anon / publishable key belongs here. Never put the
# service_role or secret key in a VITE_ variable — it would ship to every browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: where the web version is hosted (used in email links and invite links,
# which matter for the desktop app because it runs from local files).
VITE_SITE_URL=
